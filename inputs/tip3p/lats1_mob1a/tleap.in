### VERSION 1: TRUNCATED OCTAHEDRON ###
# Load the main force fields
source leaprc.protein.ff19SB
source leaprc.water.tip3p

addAtomTypes { { "ZN" "Zn" "sp3" } { "S3" "S" "sp3" } { "N2" "N" "sp3" } }
source leaprc.phosaa19SB
loadamberparams frcmod.ions1lm_126_tip3p
loadamberprep ./ZAFF.prep
loadamberparams ./ZAFF.frcmod

# Load your structure
mol = loadpdb mobL.pdb
bond mol.181.ZN mol.47.SG 
bond mol.181.ZN mol.52.SG 
bond mol.181.ZN mol.129.NE2 
bond mol.181.ZN mol.134.NE2 

check mol
savepdb mol mobL_ZAFF_dry.pdb

# Solvate with truncated octahedron
solvateoct mol TIP3PBOX 10.0


# First neutralize
addions mol Cl- 0
addions mol Na+ 0

# Then add NaCl pairs
addions mol Na+ 80
addions mol Cl- 80

savepdb mol mobL_ZAFF_solv_oct.pdb 
saveamberparm mol mobL.prmtop mobL.inpcrd

quit

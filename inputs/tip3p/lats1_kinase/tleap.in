### rebuilt 2026-09-22: kinase system with the complex build's force-field stack
### structure, solvation and ions copied verbatim from water_test/setup/lats-tip3p-2; FF loading copied from water_test/setup/moblats-tip3p-2
source leaprc.protein.ff19SB
source leaprc.water.tip3p
addAtomTypes { { "ZN" "Zn" "sp3" } { "S3" "S" "sp3" } { "N2" "N" "sp3" } }
source leaprc.phosaa19SB
loadamberparams frcmod.ions1lm_126_tip3p
loadamberprep ./ZAFF.prep
loadamberparams ./ZAFF.frcmod
mol = loadpdb lats.pdb
check mol
solvateoct mol TIP3PBOX 10.0
addions mol Cl- 0
addions mol Na+ 0
addions mol Na+ 80
addions mol Cl- 80
savepdb mol lats_solv.pdb
saveamberparm mol lats.prmtop lats.inpcrd
quit

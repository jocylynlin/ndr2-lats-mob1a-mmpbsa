### VERSION 1: TRUNCATED OCTAHEDRON ###
# Load the main force fields
source leaprc.protein.ff19SB
source leaprc.water.opc

addAtomTypes { { "ZN" "Zn" "sp3" } { "S3" "S" "sp3" } { "N2" "N" "sp3" } }
source leaprc.phosaa19SB
loadamberparams frcmod.ionslm_126_opc
loadamberprep ./ZAFF.prep
loadamberparams ./ZAFF.frcmod

# Load your structure
mol = loadpdb mobstk_chainB.pdb
bond mol.181.ZN mol.47.SG 
bond mol.181.ZN mol.52.SG 
bond mol.181.ZN mol.129.NE2 
bond mol.181.ZN mol.134.NE2 

check mol
savepdb mol mobstk_chainB_ZAFF_dry.pdb

# Solvate with truncated octahedron
solvateoct mol OPCBOX 10.0


# First neutralize
addions mol Cl- 0
addions mol Na+ 0



savepdb mol mobstk_chainB_ZAFF_solv_oct.pdb 
saveamberparm mol mobstk_chainB.prmtop mobstk_chainB.inpcrd

quit

### rebuilt 2026-09-22: kinase system with the complex build's force-field stack
### structure, solvation and ions copied verbatim from water_test/setup/stk-noions-chainD; FF loading copied from water_test/setup/mobstk-noions-chainB
source leaprc.protein.ff19SB
source leaprc.water.opc
addAtomTypes { { "ZN" "Zn" "sp3" } { "S3" "S" "sp3" } { "N2" "N" "sp3" } }
source leaprc.phosaa19SB
loadamberparams frcmod.ionslm_126_opc
loadamberprep ./ZAFF.prep
loadamberparams ./ZAFF.frcmod
mol = loadpdb stk_chainD.pdb
check mol
solvateoct mol OPCBOX 10.0
addions mol Cl- 0
addions mol Na+ 0
savepdb mol stk_chainD_solv.pdb
saveamberparm mol stk_chainD.prmtop stk_chainD.inpcrd
quit
